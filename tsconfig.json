{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/shared/**/*.js"]
}
