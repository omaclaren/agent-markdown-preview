{
	"name": "agent-markdown-preview",
	"version": "0.1.2",
	"description": "Browser preview of coding-agent responses (Claude Code, Codex, Pi) and local Markdown, LaTeX, code and diff files, with math, syntax highlighting and Mermaid.",
	"keywords": [
		"claude-code",
		"codex",
		"pi",
		"coding-agent",
		"markdown",
		"latex",
		"mermaid",
		"preview",
		"pandoc",
		"cli"
	],
	"homepage": "https://github.com/omaclaren/agent-markdown-preview#readme",
	"bugs": {
		"url": "https://github.com/omaclaren/agent-markdown-preview/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omaclaren/agent-markdown-preview.git"
	},
	"license": "MIT",
	"type": "module",
	"bin": {
		"agent-markdown-preview": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/render.d.ts",
			"import": "./dist/render.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test",
		"extract": "node scripts/extract-render-core.cjs ../pi-markdown-preview",
		"prepublishOnly": "npm test"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"micromark": "^4.0.2",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"puppeteer-core": "^25.12.0",
		"typescript": "5.9.3"
	}
}
